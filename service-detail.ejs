<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/flash') %>
<main id="main">
  <header class="page-hero compact">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/services">Services</a><span aria-hidden="true">/</span><span aria-current="page"><%= service.title %></span></nav>
      <span class="kicker">Service</span>
      <h1><span class="service-icon inline"><%- icon(service.icon, 40) %></span> <%= service.title %></h1>
      <p class="page-hero-sub"><%= service.tagline %> · <strong class="text-light"><%= service.price %></strong></p>
    </div>
  </header>

  <section class="section">
    <div class="container detail-grid">
      <div>
        <h2>What we deliver</h2>
        <p class="lead"><%= service.description %></p>
        <h3 class="mt">Scope highlights</h3>
        <ul class="check-list">
          <% service.features.forEach(function(f) { %><li><%- icon('check', 18) %> <span><%= f %></span></li><% }) %>
        </ul>
        <div class="detail-ctas">
          <a href="/contact?subject=<%= encodeURIComponent(service.title) %>" class="btn btn-primary">Discuss this service <%- icon('arrow-right', 16) %></a>
          <a href="/services" class="btn btn-outline">All services</a>
        </div>
      </div>
      <aside class="detail-aside">
        <div class="aside-card">
          <h3>How engagements start</h3>
          <ol class="aside-steps">
            <li>30-minute discovery call</li>
            <li>Fixed-scope proposal in 48h</li>
            <li>Kickoff within 1–2 weeks</li>
            <li>Two-week sprints with weekly demos</li>
          </ol>
          <p class="muted sm">Prefer email? <a class="text-link" href="mailto:hello@nexora.digital">hello@nexora.digital</a></p>
        </div>
        <% if (others.length) { %>
        <div class="aside-card">
          <h3>Related services</h3>
          <ul class="related-list">
            <% others.forEach(function(o) { %><li><a href="/services/<%= o.slug %>"><%= o.title %><small><%= o.tagline %></small></a></li><% }) %>
          </ul>
        </div>
        <% } %>
      </aside>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<script src="/js/main.js" defer></script>
</body>
</html>
