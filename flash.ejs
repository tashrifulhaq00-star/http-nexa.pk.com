<% if (flash) { %>
  <div class="flash-stack container" aria-live="polite">
    <div class="alert alert-<%= flash.type %>" role="status">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <% if (flash.type === 'success') { %><path d="M20 6 9 17l-5-5"/>
        <% } else if (flash.type === 'error') { %><path d="M12 8v5M12 16.5h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>
        <% } else { %><circle cx="12" cy="12" r="9.2"/><path d="M12 11v5M12 7.5h.01"/><% } %>
      </svg>
      <span><%= flash.message %></span>
      <button type="button" class="alert-close" aria-label="Dismiss notification">&times;</button>
    </div>
  </div>
<% } %>
