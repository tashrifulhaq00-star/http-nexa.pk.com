<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/flash') %>
<main id="main">

  <!-- ══════════ HERO ══════════ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><span class="orb orb-1"></span><span class="orb orb-2"></span><span class="orb orb-3"></span></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="pulse-dot"></span> Full-service digital agency · Peshawar, Pakistan</span>
        <h1 class="hero-title">We build digital products that <span class="gradient-text">grow businesses</span>.</h1>
        <p class="hero-sub">From brand identity to web development, mobile apps, SEO and cloud infrastructure — a senior team obsessed with speed, security and measurable results.</p>
        <div class="hero-ctas">
          <a href="/contact" class="btn btn-primary btn-lg">Start your project <%- icon('arrow-right', 18) %></a>
          <a href="/services" class="btn btn-outline btn-lg">Explore services</a>
        </div>
        <dl class="hero-proof">
          <div><dt>120+</dt><dd>projects delivered</dd></div>
          <div><dt>97%</dt><dd>on-time delivery</dd></div>
          <div><dt>4.9/5</dt><dd>client rating</dd></div>
        </dl>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <figure class="hero-frame">
          <img src="/img/hero.jpg" alt="" width="1200" height="900" fetchpriority="high">
        </figure>
        <div class="float-card float-card-1">
          <span class="float-num">+38%</span><span class="float-label">conversion after rebuild</span>
        </div>
        <div class="float-card float-card-2">
          <span class="float-num">1.4s</span><span class="float-label">median load time</span>
        </div>
      </div>
    </div>
    <div class="container"><div class="scroll-hint" aria-hidden="true">Scroll to explore <span>↓</span></div></div>
  </section>

  <!-- ══════════ CLIENT WORDMARKS ══════════ -->
  <section class="logos" aria-label="Clients we have worked with">
    <div class="container">
      <p class="logos-label">Powering teams at</p>
      <ul class="logos-row">
        <li>PakCart</li><li>MediTrack</li><li>AlImran Group</li><li>SwiftFreight</li><li>EduSpark</li><li>Verve Studio</li>
      </ul>
    </div>
  </section>

  <!-- ══════════ SERVICES ══════════ -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">What we do</span>
          <h2 id="services-title">Services engineered for outcomes</h2>
        </div>
        <a class="btn btn-outline" href="/services">View all services <%- icon('arrow-right', 16) %></a>
      </div>
      <div class="services-grid">
        <% services.forEach(function(s) { %>
          <a class="service-card" href="/services/<%= s.slug %>">
            <span class="service-icon"><%- icon(s.icon, 26) %></span>
            <h3><%= s.title %></h3>
            <p><%= s.tagline %></p>
            <span class="service-more">Explore <%- icon('arrow-right', 14) %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══════════ PROCESS ══════════ -->
  <section class="section section-alt" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head center">
        <div>
          <span class="kicker">How we work</span>
          <h2 id="process-title">A process that de-risks every launch</h2>
        </div>
      </div>
      <ol class="process-steps">
        <li><span class="step-num">01</span><h3>Discover</h3><p>Workshops, analytics and stakeholder interviews. We align on the one metric that matters before writing a line of code.</p></li>
        <li><span class="step-num">02</span><h3>Design</h3><p>Journeys, wireframes, a clickable prototype and a design system — signed off by you before build begins.</p></li>
        <li><span class="step-num">03</span><h3>Build</h3><p>Two-week sprints with demos every Friday. CI/CD, automated tests and code review on every change.</p></li>
        <li><span class="step-num">04</span><h3>Grow</h3><p>Launch is the starting line: CRO, SEO, performance budgets and a roadmap that compounds month over month.</p></li>
      </ol>
    </div>
  </section>

  <!-- ══════════ WHY US ══════════ -->
  <section class="section" aria-labelledby="why-title">
    <div class="container why-grid">
      <div class="why-copy">
        <span class="kicker">Why Nexora</span>
        <h2 id="why-title">Senior talent, founder attention, zero agency fog</h2>
        <ul class="check-list">
          <li><%- icon('check', 18) %> <span><strong>Direct access to the people doing the work.</strong> No account-manager telephone game — you Slack with the builders.</span></li>
          <li><%- icon('check', 18) %> <span><strong>Security &amp; privacy by default.</strong> OWASP-aligned delivery, encrypted secrets, audited dependencies and data-protection-first architecture.</span></li>
          <li><%- icon('check', 18) %> <span><strong>Fixed-scope sprints, transparent pricing.</strong> You always know what ships next, what it costs, and why.</span></li>
          <li><%- icon('check', 18) %> <span><strong>Post-launch partnership.</strong> 90 days of hypercare included with every build — monitoring, fixes and CRO experiments.</span></li>
        </ul>
        <a href="/about" class="btn btn-primary">Meet the team <%- icon('arrow-right', 16) %></a>
      </div>
      <aside class="why-panel" aria-label="Nexora at a glance">
        <div class="why-panel-inner">
          <div class="why-stat"><span class="why-num" data-count="130">0</span><span class="why-plus">+</span><p>projects shipped across 9 countries</p></div>
          <div class="why-stat"><span class="why-num" data-count="97">0</span><span class="why-plus">%</span><p>of launches delivered on or before deadline</p></div>
          <div class="why-stat"><span class="why-num" data-count="14">0</span><span class="why-plus">yrs</span><p>average experience of our delivery team</p></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ══════════ TESTIMONIALS ══════════ -->
  <section class="section section-alt" aria-labelledby="testimonials-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Client love</span>
          <h2 id="testimonials-title">Don't take our word for it</h2>
        </div>
        <div class="carousel-controls">
          <button class="icon-btn" id="tPrev" type="button" aria-label="Previous testimonial">←</button>
          <button class="icon-btn" id="tNext" type="button" aria-label="Next testimonial">→</button>
        </div>
      </div>
      <div class="testimonial-track" id="testimonialTrack" tabindex="0" aria-label="Testimonials carousel">
        <% testimonials.forEach(function(t) { %>
          <figure class="testimonial-card">
            <div class="stars" aria-label="Rated <%= t.rating %> out of 5"><% for (let i = 0; i < t.rating; i++) { %><%- icon('star', 16) %><% } %></div>
            <blockquote>“<%= t.quote %>”</blockquote>
            <figcaption>
              <span class="avatar-initials" aria-hidden="true"><%= t.author.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase() %></span>
              <span><strong><%= t.author %></strong><br><small><%= t.role %><%= t.company ? ' · ' + t.company : '' %></small></span>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ══════════ FAQ ══════════ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div>
        <span class="kicker">FAQ</span>
        <h2 id="faq-title">Answers, before you ask</h2>
        <p class="muted">Still curious? <a class="text-link" href="/contact">Ask us anything →</a></p>
      </div>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary>How much does a project cost?</summary>
          <p>Marketing websites start around $2,500, product builds from $8,000. After a 30-minute discovery call we send a fixed-scope proposal within two business days — no hourly ambiguity.</p>
        </details>
        <details class="faq-item">
          <summary>How long does a typical build take?</summary>
          <p>Most marketing sites launch in 4–6 weeks; full product builds run 8–16 weeks in two-week sprints. You see working software every Friday, not a big reveal at the end.</p>
        </details>
        <details class="faq-item">
          <summary>Who owns the code and designs?</summary>
          <p>You do — fully. We transfer all source code, design files, credentials and documentation at launch. No lock-in, no ransoms, ever.</p>
        </details>
        <details class="faq-item">
          <summary>Do you provide maintenance after launch?</summary>
          <p>Yes. Every build includes 90 days of hypercare (monitoring, bug fixes, small tweaks). After that, optional care plans start at $350/month.</p>
        </details>
        <details class="faq-item">
          <summary>Can you work with our in-house team?</summary>
          <p>Absolutely — we often slot into existing squads. Stand-ups, shared Figma and GitHub access, documented PRs. We make your team look good.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ══════════ CTA ══════════ -->
  <section class="section cta-section" aria-label="Start a project">
    <div class="container">
      <div class="cta-panel">
        <div>
          <h2>Have a project in mind?</h2>
          <p>Tell us where you want to be in 90 days. We'll show you the shortest honest path to get there.</p>
        </div>
        <a href="/contact" class="btn btn-light btn-lg">Get a free proposal <%- icon('arrow-right', 18) %></a>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<script src="/js/main.js" defer></script>
</body>
</html>
