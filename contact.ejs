<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/flash') %>
<main id="main">
  <header class="page-hero compact">
    <div class="container">
      <span class="kicker">Contact us</span>
      <h1>Tell us about<br><span class="gradient-text">your project.</span></h1>
      <p class="page-hero-sub">A real human reads every message. Expect a thoughtful reply within one business day — usually with a few sharp questions.</p>
    </div>
  </header>

  <section class="section">
    <div class="container contact-grid">
      <form class="form-card" method="POST" action="/contact" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2 class="form-title">Send us a message</h2>

        <% if (errors && errors.length) { %>
          <div class="alert alert-error" role="alert">
            <ul class="error-list"><% errors.forEach(function(e) { %><li><%= e %></li><% }) %></ul>
          </div>
        <% } %>

        <div class="form-row">
          <div class="field">
            <label for="c-name">Your name *</label>
            <input id="c-name" name="name" type="text" required minlength="2" maxlength="80" value="<%= form.name %>" autocomplete="name" placeholder="Ayesha Khan">
          </div>
          <div class="field">
            <label for="c-email">Work email *</label>
            <input id="c-email" name="email" type="email" required maxlength="160" value="<%= form.email %>" autocomplete="email" placeholder="you@company.com">
          </div>
        </div>
        <div class="field">
          <label for="c-subject">What do you need?</label>
          <select id="c-subject" name="subject">
            <% ['Web development','UI/UX design','Mobile apps','SEO & growth','Brand identity','Cloud & DevOps','General enquiry'].forEach(function(s) { %>
              <option value="<%= s %>" <%= form.subject === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="c-message">Your message *</label>
          <textarea id="c-message" name="message" required minlength="10" maxlength="5000" rows="5" placeholder="Goals, timeline, budget range — the more context the better."><%= form.message %></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Send message <%- icon('arrow-right', 18) %></button>
        <p class="form-note">By submitting you agree to our <a href="/privacy">Privacy Policy</a>. We never share your details.</p>
      </form>

      <aside class="contact-aside">
        <div class="aside-card">
          <h3>Studio</h3>
          <p class="footer-contact">Office 4, Pak Tower, Saddar Road<br>Peshawar 25000, Khyber Pakhtunkhwa<br>Pakistan</p>
          <p class="footer-contact"><strong>Hours</strong><br>Mon–Sat, 9:30–18:30 PKT<br><span class="muted">Sundays: emergency support only</span></p>
        </div>
        <div class="aside-card">
          <h3>Direct lines</h3>
          <p class="footer-contact"><a class="text-link" href="mailto:hello@nexora.digital">hello@nexora.digital</a><br><a class="text-link" href="tel:+92917042040">+92 91 704 2040</a></p>
          <p class="muted sm">Prefer WhatsApp? <a class="text-link" href="https://wa.me/92917042040" target="_blank" rel="noopener noreferrer">Message us →</a></p>
        </div>
        <div class="aside-card accent">
          <h3>Response promise</h3>
          <p><strong>&lt; 1 business day</strong> for new enquiries.<br><strong>&lt; 4 hours</strong> for active clients on care plans.</p>
        </div>
      </aside>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<script src="/js/main.js" defer></script>
</body>
</html>
