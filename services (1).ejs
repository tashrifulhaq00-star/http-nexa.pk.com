<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>
<main id="main" class="section admin-main">
  <div class="container admin-layout">
    <%- include('../partials/admin-sidebar') %>
    <div class="admin-content">
      <div class="admin-page-head"><h1 class="admin-h1">Services</h1><p class="muted">Create, edit, hide or remove the services shown across the site.</p></div>

      <details class="panel create-panel">
        <summary class="create-summary">+ Add a new service</summary>
        <form method="POST" action="/admin/services" class="service-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="field"><label for="ns-slug">Slug *</label><input id="ns-slug" name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="search-marketing"></div>
            <div class="field"><label for="ns-icon">Icon</label>
              <select id="ns-icon" name="icon">
                <% ['code','pen','phone','chart','sparkles','cloud'].forEach(function(i) { %><option value="<%= i %>"><%= i %></option><% }) %>
              </select>
            </div>
          </div>
          <div class="field"><label for="ns-title">Title *</label><input id="ns-title" name="title" required maxlength="90" placeholder="Search Marketing"></div>
          <div class="field"><label for="ns-tagline">Tagline</label><input id="ns-tagline" name="tagline" maxlength="140" placeholder="Short one-liner shown on cards"></div>
          <div class="field"><label for="ns-desc">Description</label><textarea id="ns-desc" name="description" rows="3" maxlength="2000"></textarea></div>
          <div class="form-row">
            <div class="field"><label for="ns-price">Price label</label><input id="ns-price" name="price" maxlength="60" placeholder="from $1,000"></div>
            <div class="field"><label for="ns-sort">Sort order</label><input id="ns-sort" name="sort_order" type="number" value="10"></div>
          </div>
          <div class="field"><label for="ns-features">Features <span class="muted">(one per line)</span></label><textarea id="ns-features" name="features" rows="4" placeholder="Technical audits&#10;Keyword strategy"></textarea></div>
          <button type="submit" class="btn btn-primary">Create service</button>
        </form>
      </details>

      <div class="service-admin-list">
        <% services.forEach(function(s) { %>
          <details class="panel service-admin-item <%= s.is_active ? '' : 'is-hidden' %>">
            <summary class="service-admin-summary">
              <span class="service-icon sm"><%- icon(s.icon, 20) %></span>
              <span class="service-admin-title"><strong><%= s.title %></strong><small class="muted">/<%= s.slug %> · <%= s.price %></small></span>
              <span class="status-pill <%= s.is_active ? 'status-read' : 'status-archived' %>"><%= s.is_active ? 'live' : 'hidden' %></span>
            </summary>
            <form method="POST" action="/admin/services/<%= s.id %>" class="service-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-row">
                <div class="field"><label>Slug *</label><input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" value="<%= s.slug %>"></div>
                <div class="field"><label>Icon</label>
                  <select name="icon">
                    <% ['code','pen','phone','chart','sparkles','cloud'].forEach(function(i) { %><option value="<%= i %>" <%= s.icon === i ? 'selected' : '' %>><%= i %></option><% }) %>
                  </select>
                </div>
              </div>
              <div class="field"><label>Title *</label><input name="title" required maxlength="90" value="<%= s.title %>"></div>
              <div class="field"><label>Tagline</label><input name="tagline" maxlength="140" value="<%= s.tagline %>"></div>
              <div class="field"><label>Description</label><textarea name="description" rows="3" maxlength="2000"><%= s.description %></textarea></div>
              <div class="form-row">
                <div class="field"><label>Price label</label><input name="price" maxlength="60" value="<%= s.price %>"></div>
                <div class="field"><label>Sort order</label><input name="sort_order" type="number" value="<%= s.sort_order %>"></div>
              </div>
              <div class="field"><label>Features <span class="muted">(one per line)</span></label><textarea name="features" rows="4"><%= s.features.join('\n') %></textarea></div>
              <div class="row-actions">
                <button type="submit" class="btn btn-primary btn-sm">Save changes</button>
              </div>
            </form>
            <div class="row-actions service-admin-foot">
              <form method="POST" action="/admin/services/<%= s.id %>/toggle" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="mini-btn"><%= s.is_active ? 'Hide from site' : 'Publish' %></button></form>
              <form method="POST" action="/admin/services/<%= s.id %>/delete" class="inline-form" data-confirm="Delete service “<%= s.title %>” permanently?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="mini-btn danger">Delete service</button></form>
            </div>
          </details>
        <% }) %>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/main.js" defer></script>
</body>
</html>
